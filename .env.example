# Supabase frontend config
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"

# Admin gate
ADMIN_DASHBOARD_PASSWORD="change-me"

# Brawl Stars API (server only)
BRAWL_STARS_API_KEY="replace-with-rotated-key"

# Prisma / DB
DATABASE_URL="postgresql://postgres.your-project:[YOUR-PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-project:[YOUR-PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres"
